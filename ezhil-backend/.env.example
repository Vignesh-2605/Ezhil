# ── Core ─────────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./ezhil.db
# REQUIRED in production. The app refuses to start on the dev default unless
# DEMO_MODE=true. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-replace-with-256-bit-random-hex-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=30

# ── Server ───────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=INFO
# "*" allows any origin and disables credentialed CORS (bearer tokens still
# work). For production list real origins instead:
#   ALLOWED_ORIGINS=https://ezhil.example.org,http://localhost:3000
ALLOWED_ORIGINS=*

# ── Demo / offline ───────────────────────────────────────────────────────────
# true  = skip the SLM, OCR and translation engines entirely. Lesson generation
#         falls back to the deterministic generator and returns in <1s.
# false = load Gemma via llama-server and NLLB for bilingual glosses.
DEMO_MODE=false

# ── SLM (lesson generation) ──────────────────────────────────────────────────
SLM_MODEL_NAME=unsloth/gemma-4-E4B-it-qat-GGUF
GGUF_PATH=E:/PDD/10-03-2026/DysLearn/models/gemma-4-E4B-it-qat-UD-Q4_K_XL.gguf
LLAMA_SERVER_BIN=E:/PDD/10-03-2026/DysLearn/models/llama.cpp/llama-server.exe
LLAMA_SERVER_URL=http://127.0.0.1:8091
SLM_MAX_TOKENS=2048
SLM_N_THREADS=4
SLM_TIMEOUT_S=180
SLM_GROUNDING_MIN=0.75
MAX_LESSON_LINES=15

# ── OCR ──────────────────────────────────────────────────────────────────────
OCR_FALLBACK_ENABLED=true

# ── Translation (bilingual glosses) ──────────────────────────────────────────
# NLLB-200-distilled-600M, ~2.4 GB, downloaded from HuggingFace on first use
# and pre-warmed at startup. Set false to use the built-in dictionary instead:
# lower quality, instant, fully offline.
TRANSLATION_ENABLED=true
# true = never touch the network for model weights (requires a warm HF cache)
HF_LOCAL_FILES_ONLY=false
