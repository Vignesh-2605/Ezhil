<?xml version="1.0" encoding="utf-8"?>
<!--
  Tamil font family declaration for BaloTamizha2.
  TTFs must be placed in res/font/ as:
    balo_tamizha2_regular.ttf
    balo_tamizha2_bold.ttf
  Download from: https://fonts.google.com/specimen/Baloo+Thambi+2
-->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font
        android:fontStyle="normal"
        android:fontWeight="400"
        android:font="@font/balo_tamizha2_regular" />
    <font
        android:fontStyle="normal"
        android:fontWeight="700"
        android:font="@font/balo_tamizha2_bold" />
</font-family>
