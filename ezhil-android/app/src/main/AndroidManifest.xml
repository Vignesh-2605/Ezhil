<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- Audio for Read Aloud assessment -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Camera for Lesson Studio OCR -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- WorkManager background -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Cleartext is decided per build type rather than app-wide. The debug
         variant overrides network_security_config.xml with one that allows
         plain HTTP to a development laptop; release permits none. This
         replaced android:usesCleartextTraffic="true", which applied to every
         build and every host, including a school's. -->
    <application
        android:name=".EzhilApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="எழில்"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.Ezhil">

        <!-- Portrait-locked: the reading assessment records audio across the
             whole session, and a rotation-triggered activity restart would
             discard it. The UI is designed portrait-first for tablets held
             upright by children. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- WorkManager initialisation (disabled so HiltWorkerFactory takes over) -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
